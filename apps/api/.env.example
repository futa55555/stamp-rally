# Local API settings. Remote API instances receive these from their deployment environment.
# See ../../docs/build-setup.md. Never place API secrets in EXPO_PUBLIC_* variables.
DATABASE_URL="postgresql://stamp_rally:stamp_rally@localhost:5432/stamp_rally?schema=public"

JWT_ACCESS_SECRET="replace-with-random-secret"
JWT_ACCESS_TTL_SECONDS="900"
REFRESH_TOKEN_TTL_DAYS="30"

# One allowed client per provider, for this API's environment only.
# Must match the mobile app's EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID.
GOOGLE_OAUTH_CLIENT_ID="your-local-web-client-id.apps.googleusercontent.com"
# Must match the mobile app's iOS Bundle ID.
APPLE_OAUTH_CLIENT_ID="com.futa.stamprally.local"

PORT=3000

# Private object storage. Leave blank until an R2 account and bucket exist.
# API and media worker must use the same settings. Never use EXPO_PUBLIC_*.
R2_ACCOUNT_ID=""
# Optional endpoint override; otherwise derived from R2_ACCOUNT_ID.
R2_ENDPOINT=""
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# Worker executables (the worker Docker image includes both).
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"

# Explicit allowlist for importing existing mediaUrl records. Empty disables import.
# Comma-separated HTTPS origins, for example https://old-images.example.com.
MEDIA_LEGACY_ALLOWED_ORIGINS=""
