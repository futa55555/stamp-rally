// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String           @id @default(uuid()) @db.Uuid
  name                String?          @unique @db.VarChar(20)
  status              UserStatus       @default(ONBOARDING)
  accounts            AuthAccount[]
  sessions            Session[]
  createdTrips        Trip[]           @relation("TripCreator")
  memberships         TripMember[]
  receivedInvitations TripInvitation[] @relation("InvitationRecipient")
  sentInvitations     TripInvitation[] @relation("InvitationSender")
  posts               Post[]
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("users")
}

enum UserStatus {
  ONBOARDING
  ACTIVE
}

model AuthAccount {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  provider          AuthProvider
  providerAccountId String       @map("provider_account_id")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@unique([provider, providerAccountId])
  @@map("auth_accounts")
}

enum AuthProvider {
  GOOGLE
  APPLE
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(64)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Trip {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @db.VarChar(100)
  startDate     DateTime @map("start_date") @db.Date
  endDate       DateTime @map("end_date") @db.Date
  coverImageUrl String?  @map("cover_image_url") @db.VarChar(2048)
  createdById   String   @map("created_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy   User             @relation("TripCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members     TripMember[]
  invitations TripInvitation[]
  genres      Genre[]

  @@index([createdById])
  @@index([createdAt, id])
  @@map("trips")
}

model TripMember {
  id        String   @id @default(uuid()) @db.Uuid
  tripId    String   @map("trip_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([tripId, userId])
  @@index([userId, tripId])
  @@index([tripId, createdAt, id])
  @@map("trip_members")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model TripInvitation {
  id          String           @id @default(uuid()) @db.Uuid
  tripId      String           @map("trip_id") @db.Uuid
  inviteeId   String           @map("invitee_id") @db.Uuid
  invitedById String           @map("invited_by_id") @db.Uuid
  status      InvitationStatus @default(PENDING)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  trip      Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  invitee   User @relation("InvitationRecipient", fields: [inviteeId], references: [id], onDelete: Restrict)
  invitedBy User @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)

  @@unique([tripId, inviteeId])
  @@index([inviteeId, status, createdAt, id])
  @@index([tripId, createdAt, id])
  @@index([invitedById])
  @@map("trip_invitations")
}

model Genre {
  id          String   @id @default(uuid()) @db.Uuid
  tripId      String   @map("trip_id") @db.Uuid
  name        String   @db.VarChar(100)
  description String   @default("") @db.VarChar(2000)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  trip   Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  stamps Stamp[]

  @@index([tripId, createdAt, id])
  @@map("genres")
}

model Stamp {
  id          String   @id @default(uuid()) @db.Uuid
  genreId     String   @map("genre_id") @db.Uuid
  name        String   @db.VarChar(100)
  description String   @default("") @db.VarChar(2000)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  genre Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)
  posts Post[]

  @@index([genreId, createdAt, id])
  @@map("stamps")
}

enum MediaType {
  IMAGE
  VIDEO
}

model Post {
  id         String    @id @default(uuid()) @db.Uuid
  stampId    String    @map("stamp_id") @db.Uuid
  authorId   String    @map("author_id") @db.Uuid
  mediaType  MediaType @map("media_type")
  mediaUrl   String    @map("media_url") @db.VarChar(2048)
  isFavorite Boolean   @default(false) @map("is_favorite")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  stamp  Stamp @relation(fields: [stampId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([stampId, createdAt, id])
  @@index([stampId, isFavorite, createdAt, id])
  @@index([authorId])
  @@map("posts")
}
