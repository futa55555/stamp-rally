// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String           @id @default(uuid()) @db.Uuid
  name                String?          @unique @db.VarChar(20)
  status              UserStatus       @default(ONBOARDING)
  accounts            AuthAccount[]
  sessions            Session[]
  createdTrips        Trip[]           @relation("TripCreator")
  memberships         TripMember[]
  receivedInvitations TripInvitation[] @relation("InvitationRecipient")
  sentInvitations     TripInvitation[] @relation("InvitationSender")
  invitationLinks     InvitationLink[]
  photoReads          PhotoRead[]
  notifications       Notification[]
  posts               Post[]
  uploadBatches       UploadBatch[]
  coverAssets         CoverAsset[]
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("users")
}

enum UserStatus {
  ONBOARDING
  ACTIVE
}

model AuthAccount {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  provider          AuthProvider
  providerAccountId String       @map("provider_account_id")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@unique([provider, providerAccountId])
  @@map("auth_accounts")
}

enum AuthProvider {
  GOOGLE
  APPLE
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(64)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Trip {
  id            String   @id @default(uuid()) @db.Uuid
  clientRequestId String? @map("client_request_id") @db.Uuid
  name          String   @db.VarChar(100)
  locations     String[] @default([])
  activityPresets String[] @default([]) @map("activity_presets")
  customActivities String[] @default([]) @map("custom_activities")
  startDate     DateTime @map("start_date") @db.Date
  endDate       DateTime @map("end_date") @db.Date
  coverImageUrl String?  @map("cover_image_url") @db.VarChar(2048)
  coverAssetId  String?  @unique @map("cover_asset_id") @db.Uuid
  coverAsset    CoverAsset? @relation(fields: [coverAssetId], references: [id], onDelete: SetNull)
  createdById   String   @map("created_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy     User             @relation("TripCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members       TripMember[]
  invitations   TripInvitation[]
  invitationLinks InvitationLink[]
  genres        Genre[]
  notifications Notification[]

  @@unique([createdById, clientRequestId])
  @@index([createdById])
  @@index([createdAt, id])
  @@map("trips")
}

model TripMember {
  id        String   @id @default(uuid()) @db.Uuid
  tripId    String   @map("trip_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([tripId, userId])
  @@index([userId, tripId])
  @@index([tripId, createdAt, id])
  @@map("trip_members")
}

enum InvitationStatus {
  PENDING_CONFIRMATION
  CANCELLED
  PENDING
  ACCEPTED
  DECLINED
}

model TripInvitation {
  id          String           @id @default(uuid()) @db.Uuid
  tripId      String           @map("trip_id") @db.Uuid
  inviteeId   String           @map("invitee_id") @db.Uuid
  invitedById String           @map("invited_by_id") @db.Uuid
  status      InvitationStatus @default(PENDING_CONFIRMATION)
  generation  Int              @default(1)
  linkId      String?          @map("link_id") @db.Uuid
  link        InvitationLink?  @relation(fields: [linkId], references: [id], onDelete: SetNull)
  notifications Notification[]
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  trip      Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  invitee   User @relation("InvitationRecipient", fields: [inviteeId], references: [id], onDelete: Restrict)
  invitedBy User @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)

  @@unique([tripId, inviteeId])
  @@index([inviteeId, status, createdAt, id])
  @@index([tripId, createdAt, id])
  @@index([invitedById])
  @@map("trip_invitations")
}

model InvitationLink {
  id String @id @default(uuid()) @db.Uuid
  tripId String @map("trip_id") @db.Uuid
  createdById String @map("created_by_id") @db.Uuid
  tokenHash String @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  invitations TripInvitation[]
  notifications Notification[]

  @@index([tripId, createdAt, id])
  @@index([createdById])
  @@map("invitation_links")
}

model Genre {
  id          String   @id @default(uuid()) @db.Uuid
  tripId      String   @map("trip_id") @db.Uuid
  name        String   @db.VarChar(100)
  description String   @default("") @db.VarChar(2000)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  trip   Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  stamps Stamp[]

  @@index([tripId, createdAt, id])
  @@map("genres")
}

model Stamp {
  id          String   @id @default(uuid()) @db.Uuid
  genreId     String   @map("genre_id") @db.Uuid
  name        String   @db.VarChar(100)
  description String   @default("") @db.VarChar(2000)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  genre Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)
  posts Post[]

  @@index([genreId, createdAt, id])
  @@map("stamps")
}

enum MediaType {
  IMAGE
  VIDEO
}

enum MediaStatus {
  LEGACY
  PENDING
  PROCESSING
  READY
  FAILED
  CANCELLED
}

model CoverAsset {
  id String @id @default(uuid()) @db.Uuid
  authorId String? @map("author_id") @db.Uuid
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  clientRequestId String @map("client_request_id") @db.Uuid
  status MediaStatus @default(PENDING)
  byteSize Int @map("byte_size")
  mimeType String @map("mime_type") @db.VarChar(127)
  stagingKey String? @map("staging_key")
  imageKey String? @map("image_key")
  blurhash String?
  width Int?
  height Int?
  errorCode String? @map("error_code")
  processingAttempts Int @default(0) @map("processing_attempts")
  processingStartedAt DateTime? @map("processing_started_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  trip Trip?

  @@unique([authorId, clientRequestId])
  @@index([status, expiresAt])
  @@map("cover_assets")
}

model UploadBatch {
  id              String @id @default(uuid()) @db.Uuid
  authorId        String @map("author_id") @db.Uuid
  clientRequestId String? @map("client_request_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  author          User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  posts           Post[]

  @@unique([authorId, clientRequestId])
  @@index([createdAt])
  @@map("upload_batches")
}

// Durable cleanup outbox: it survives deletion of a post, stamp, or trip.
model MediaCleanup {
  id                String @id @default(uuid()) @db.Uuid
  keys              String[]
  multipartKey      String? @map("multipart_key")
  multipartUploadId String? @map("multipart_upload_id")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("media_cleanup")
}

model Post {
  id         String    @id @default(uuid()) @db.Uuid
  stampId    String    @map("stamp_id") @db.Uuid
  authorId   String    @map("author_id") @db.Uuid
  mediaType  MediaType @map("media_type")
  // Retained only as an import source for legacy records, never a display URL.
  mediaUrl   String?   @map("media_url") @db.VarChar(2048)
  status MediaStatus @default(PENDING)
  originalKey String? @map("original_key")
  largeKey String? @map("large_key")
  smallKey String? @map("small_key")
  playbackKey String? @map("playback_key")
  blurhash String?
  fileName String? @map("file_name") @db.VarChar(255)
  mimeType String? @map("mime_type") @db.VarChar(127)
  byteSize Int? @map("byte_size")
  width Int?
  height Int?
  duration Float?
  uploadBatchId String? @map("upload_batch_id") @db.Uuid
  clientId String? @map("client_id") @db.VarChar(128)
  stagingKey String? @map("staging_key")
  multipartUploadId String? @map("multipart_upload_id")
  uploadExpiresAt DateTime? @map("upload_expires_at") @db.Timestamptz(3)
  errorCode String? @map("error_code") @db.VarChar(100)
  processingVersion Int @default(0) @map("processing_version")
  processingAttempts Int @default(0) @map("processing_attempts")
  processingStartedAt DateTime? @map("processing_started_at") @db.Timestamptz(3)
  readyAt DateTime? @map("ready_at") @db.Timestamptz(3)
  isLegacy Boolean @default(false) @map("is_legacy")
  isFavorite Boolean   @default(false) @map("is_favorite")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  uploadBatch   UploadBatch?   @relation(fields: [uploadBatchId], references: [id], onDelete: SetNull)
  stamp         Stamp          @relation(fields: [stampId], references: [id], onDelete: Cascade)
  author        User           @relation(fields: [authorId], references: [id], onDelete: Restrict)
  reads         PhotoRead[]
  notifications Notification[]

  @@index([status, uploadExpiresAt])
  @@index([uploadBatchId])
  @@index([stampId, status, createdAt, id])
  @@index([stampId, createdAt, id])
  @@index([stampId, isFavorite, createdAt, id])
  @@index([authorId])
  @@map("posts")
}

model PhotoRead {
  userId String   @map("user_id") @db.Uuid
  postId String   @map("post_id") @db.Uuid
  readAt DateTime @default(now()) @map("read_at") @db.Timestamptz(3)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post   Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
  @@map("photo_reads")
}

model Notification {
  id          String    @id @default(uuid()) @db.Uuid
  recipientId String    @map("recipient_id") @db.Uuid
  tripId      String    @map("trip_id") @db.Uuid
  postId      String?   @map("post_id") @db.Uuid
  invitationId String? @map("invitation_id") @db.Uuid
  invitation TripInvitation? @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  invitationLinkId String? @map("invitation_link_id") @db.Uuid
  invitationLink InvitationLink? @relation(fields: [invitationLinkId], references: [id], onDelete: Cascade)
  title       String
  body        String
  target      Json
  readAt      DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  recipient   User      @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  trip        Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  post        Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt, id])
  @@index([recipientId, readAt])
  @@index([tripId])
  @@index([postId])
  @@index([invitationId])
  @@index([invitationLinkId])
  @@unique([recipientId, invitationLinkId])
  @@map("notifications")
}
