# Device-reachable API origin. iOS simulator: http://localhost:3000
# Android emulator: http://10.0.2.2:3000; physical devices: your development server URL.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Google Cloud OAuth clients (public IDs, never put a client secret here).
# Web client: also configure GOOGLE_OAUTH_CLIENT_ID on the API.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS client for com.futa.stamprally; app.config.ts derives its reversed URL scheme.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
