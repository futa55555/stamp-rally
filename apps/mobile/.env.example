# Local simulator/emulator configuration. See ../../docs/build-setup.md.
# APP_VARIANT is selected by package scripts / eas.json; do not set it here.

# iOS simulator and Android with `pnpm mobile:android:connect` use localhost.
# Android setup: ../../docs/android-development.md. Devices on Wi-Fi need a reachable server URL.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Google Cloud OAuth clients (public IDs, never put a client secret here).
# Local Web client: also configure GOOGLE_OAUTH_CLIENT_ID on the local API.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS client for com.futa.stamprally.local; app.config.ts derives its reversed URL scheme.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Apple Developer Team ID (not the account email). Optional for simulators.
# Set this before regenerating the native project to select the correct signing team.
APPLE_TEAM_ID=

# Sharing is enabled when this origin is set; leave blank to disable sharing.
# Local HTTP is for Web testing. HTTPS app associations require a native rebuild.
EXPO_PUBLIC_INVITATION_ORIGIN=http://localhost:5173
