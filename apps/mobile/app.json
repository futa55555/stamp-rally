{
  "expo": {
    "name": "Stamp Rally",
    "slug": "stamp-rally",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.futa.stamprally",
      "supportsTablet": true,
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.futa.stamprally",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-apple-authentication",
      "expo-font",
      "expo-router",
      "expo-splash-screen",
      [
        "expo-image-picker",
        {
          "photosPermission": "旅行に投稿する写真を選ぶために写真へのアクセスを使用します。",
          "cameraPermission": "旅行に投稿する写真を撮影するためにカメラを使用します。",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "expo-asset",
      [
        "expo-media-library",
        {
          "photosPermission": "旅行に投稿する写真を選ぶために写真へのアクセスを使用します。",
          "savePhotosPermission": "投稿の写真を端末の写真ライブラリに保存します。",
          "granularPermissions": []
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "88124691-85cc-48af-91cd-53d1029509f1"
      }
    },
    "owner": "fuesugi",
    "scheme": "stamp-rally",
    "experiments": {
      "typedRoutes": true
    }
  }
}
