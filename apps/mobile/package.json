{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/react-native-action-sheet": "^4.1.1",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.102.8",
    "axios": "^1.20.0",
    "expo": "~57.0.19",
    "expo-apple-authentication": "~57.0.1",
    "expo-asset": "~57.0.16",
    "expo-build-properties": "~57.0.17",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.18",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-image": "~57.0.4",
    "expo-image-manipulator": "~57.0.16",
    "expo-image-picker": "~57.0.16",
    "expo-linking": "~57.0.9",
    "expo-media-library": "~57.0.4",
    "expo-network": "~57.0.1",
    "expo-router": "~57.0.19",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.18",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-video": "~57.0.3",
    "nativewind": "~4.2.6",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-calendars": "^1.1314.0",
    "react-native-css-interop": "0.2.6",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nitro-google-signin": "^2.1.0",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "19.1.0",
    "babel-preset-expo": "~57.0.10",
    "eas-cli": "23.2.0",
    "react-test-renderer": "19.2.3",
    "tailwindcss": "~3.4.19",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "start": "APP_VARIANT=local expo start --dev-client",
    "start:remote": "EXPO_NO_DOTENV=1 eas env:exec development 'node scripts/validate-remote-env.mjs && APP_VARIANT=development EXPO_NO_DOTENV=1 expo start --dev-client --clear'",
    "android": "APP_VARIANT=local expo run:android",
    "android:connect": "adb reverse tcp:3000 tcp:3000 && adb reverse tcp:5173 tcp:5173 && adb reverse tcp:8081 tcp:8081",
    "ios": "APP_VARIANT=local expo run:ios",
    "web": "APP_VARIANT=local expo start --web",
    "prebuild:local": "APP_VARIANT=local expo prebuild",
    "build:development": "EXPO_NO_DOTENV=1 eas build --profile development",
    "build:staging": "EXPO_NO_DOTENV=1 eas build --profile staging",
    "build:production": "EXPO_NO_DOTENV=1 eas build --profile production",
    "eas-build-pre-install": "node scripts/validate-remote-env.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "private": true
}
