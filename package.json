{
  "name": "stamp-rally",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "scripts": {
    "api:dev": "pnpm --filter api start:dev",
    "mobile:start": "pnpm --filter mobile start",
    "mobile:start:remote": "pnpm --filter mobile start:remote",
    "mobile:ios": "pnpm --filter mobile ios",
    "mobile:android": "pnpm --filter mobile android",
    "mobile:build:development": "pnpm --filter mobile build:development",
    "mobile:build:staging": "pnpm --filter mobile build:staging",
    "mobile:build:production": "pnpm --filter mobile build:production",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "typecheck": "pnpm -r --no-bail run typecheck"
  },
  "devDependencies": {
    "oxlint": "1.81.0",
    "prettier": "3.9.6"
  }
}
